# MindGuard Environment Configuration Template
# Copy this file to .env and configure values before starting the application:
# cp .env.example .env

# Flask Server Configuration
FLASK_ENV=development
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
FLASK_SECRET_KEY=change_this_in_production_to_a_secure_random_secret

# AI & LLM Service
# (Optional: If omitted, MindGuard seamlessly falls back to local Ollama or the built-in offline Knowledge Base)
GEMINI_API_KEY=

# Database Configuration (MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/mindguard_db
MONGO_DB_NAME=mindguard_db
# Set USE_MONGOMOCK=true if running without a local MongoDB service installed:
USE_MONGOMOCK=false

# Security & CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=60
MAX_MESSAGE_LENGTH=2000
DEFAULT_RETENTION_DAYS=30
