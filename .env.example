# MindGuard Environment Configuration Template
# Copy this file to .env and configure values before starting the application:
# cp .env.example .env

# Flask Server Configuration
FLASK_ENV=development
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
FLASK_SECRET_KEY=change_this_in_production_to_a_secure_random_secret

# AI & LLM Service
# (Optional: If omitted, MindGuard seamlessly falls back to local Ollama or the built-in offline Knowledge Base)
GEMINI_API_KEY=

# Database Configuration (MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/mindguard_db
MONGO_DB_NAME=mindguard_db
# Set USE_MONGOMOCK=true if running without a local MongoDB service installed:
USE_MONGOMOCK=false

# Security & CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=60
MAX_MESSAGE_LENGTH=2000
DEFAULT_RETENTION_DAYS=30

# Authentication (REQUIRED outside local dev; auth.py fails fast on weak values in production)
JWT_SECRET_KEY=change_me_to_a_random_32plus_char_secret
JWT_EXPIRATION_HOURS=24

# LLM providers (configured provider wins; offline KB is the final fallback)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=3.5
GROQ_MAX_TOKENS=250
OLLAMA_RESPONSE_TIMEOUT_SECONDS=20.0

# Record retention (days) for clinical safety events and audit metadata
SAFETY_LOG_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_DAYS=90

# Comma-separated proxy IPs allowed to set X-Forwarded-For (leave empty when none)
TRUSTED_PROXIES=
# Opt-in remember-me refresh-token lifetime (days)
REFRESH_TOKEN_TTL_DAYS=7
